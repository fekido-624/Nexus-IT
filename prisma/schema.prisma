generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  uid        String        @id @default(cuid())
  name       String
  email      String        @unique
  password   String
  department String
  jawatan    String? 
  role       String
  requests   BorrowRequest[]
}

model Asset {
  assetId     String         @id @default(cuid())
  category    String
  brand       String
  model       String
  assetTag    String         @unique
  description String
  status      String
  availableQty Int
  addedDate   String
  lastUpdated String
  imageUrl    String?
  usageType   String         @default("gunasama")
  units       AssetUnit[]

  items    BorrowRequestItem[]  // ← tambah ni
}

model AssetUnit {
  unitId             String  @id @default(cuid())
  assetId            String
  assetName          String
  assetTag           String
  brand              String
  model              String
  category           String
  condition          String
  currentStatus      String
  currentBorrowerId  String?
  currentBorrowerName String?
  currentRequestId   String?
  purchaseDate       String?
  notes              String
  addedDate          String
  borrowHistory      String?
  assignedDate       String?
  asset              Asset   @relation(fields: [assetId], references: [assetId])
}

model BorrowRequest {
  requestId    String              @id @default(cuid())
  userId       String
  userName     String
  userDept     String
  purpose      String
  location    String?
  borrowDate   String
  returnDate   String
  status       String
  approvedBy   String?
  requestDate  String
  notes        String?
  user         User                @relation(fields: [userId], references: [uid])
  items        BorrowRequestItem[]
}

model BorrowRequestItem {
  itemId               String        @id @default(cuid())
  requestId            String
  assetId              String
  assetName            String
  assignedUnitId       String?
  assignedAssetTag     String?
  assignedSerialNumber String?
  status               String
  notes                String?
  request              BorrowRequest @relation(fields: [requestId], references: [requestId])
  asset                Asset         @relation(fields: [assetId], references: [assetId])
}

model AssetCategory {
  id        String   @id
  name      String   @unique
  slug      String
  addedDate String
}

model CustodyRecord {
  custodyId    String  @id
  unitId       String
  assetId      String
  assetName    String
  assetTag     String
  userId       String
  userName     String
  userDept     String
  assignedBy   String
  assignedDate String
  status       String
  revokedBy    String?
  revokedDate  String?
  location     String?
  notes        String?
}

model FloorPlan {
  id        String      @id @default(cuid())
  name      String
  imageUrl  String
  addedDate String
  zones     FloorZone[]
}

model FloorZone {
  id               String    @id @default(cuid())
  floorPlanId      String
  label            String
  x                Float
  y                Float
  width            Float
  height           Float
  portNumber       String?
  assignedUserId   String?
  assignedUserName String?
  notes            String?
  floorPlan        FloorPlan @relation(fields: [floorPlanId], references: [id])
}